{
    "name": "tusten-framework",
    "version": "0.2.0-beta.6",
    "private": true,
    "type": "module",
    "description": "tusten — fullstack React framework on React 19 + Fastify + Vite",
    "license": "MIT",
    "author": "yar.tema",
    "homepage": "https://github.com/yartema/tusten-framework#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yartema/tusten-framework.git"
    },
    "bugs": {
        "url": "https://github.com/yartema/tusten-framework/issues"
    },
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.tests.json --noEmit",
        "build": "pnpm --filter @tusten/core build",
        "inspect:basic": "pnpm --filter examples-basic inspect",
        "dev:basic": "pnpm --filter examples-basic dev",
        "build:basic": "pnpm --filter examples-basic exec tusten build",
        "start:basic": "pnpm --filter examples-basic exec tusten start",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:basic": "vitest run",
        "test:coverage": "vitest run --coverage",
        "publish:alpha": "pnpm --filter @tusten/core build && cd packages/tusten && npm publish --tag alpha --access public && cd ../.. && npm dist-tag add @tusten/core@0.2.0-beta.5 alpha && npm dist-tag add @tusten/core@0.2.0-beta.5 latest",
        "publish:beta": "pnpm --filter @tusten/core build && cd packages/tusten && npm publish --tag beta --access public && cd ../.. && npm dist-tag add @tusten/core@0.2.0-beta.5 beta && npm dist-tag add @tusten/core@0.2.0-beta.5 latest",
        "publish:latest": "pnpm --filter @tusten/core build && cd packages/tusten && npm publish --tag latest --access public",
        "version:alpha": "pnpm --filter @tusten/core exec npm version prerelease --preid=alpha",
        "version:patch": "pnpm --filter @tusten/core exec npm version patch",
        "version:minor": "pnpm --filter @tusten/core exec npm version minor",
        "version:major": "pnpm --filter @tusten/core exec npm version major"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.10.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "devalue": "^6.0.3",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^50.6.1",
        "fastify": "^5.12.8",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.0",
        "vite": "^8.3.7",
        "vitest": "^5.1.0"
    }
}
